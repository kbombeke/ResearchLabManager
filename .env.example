# Copy this file to .env and fill in your Supabase project values.
# Find them in the Supabase dashboard under Settings -> API.
# These are NOT secrets: the anon key is public and guarded by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override the UGent Biblio API base path. Defaults to /biblio-api,
# which your web server (or the Docker image / Vite dev server) reverse-proxies
# to https://biblio.ugent.be. Leave unset unless you know you need it.
# VITE_BIBLIO_BASE=/biblio-api
